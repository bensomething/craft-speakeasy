{# Structural styles for the bundled unlock screen. Shared with the settings-page
   preview so the two can't drift. Theme values come from Settings::DEFAULT_CSS,
   which is included ahead of this. #}
* { box-sizing: border-box; }
body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    font-family: var(--speakeasy-font);
    background: var(--speakeasy-bg);
    color: var(--speakeasy-fg);
}
.speakeasy { width: 100%; max-width: 22rem; position: relative; }
.speakeasy__row { display: flex; gap: .5rem; }
.speakeasy__input {
    flex: 1 1 auto;
    padding: .6rem .75rem;
    border: 1px solid var(--speakeasy-input-border);
    border-radius: var(--speakeasy-radius);
    background: var(--speakeasy-input-bg);
    color: inherit;
    font-family: inherit;
    font-size: 1rem;
}
.speakeasy__input:focus { outline: none; border-color: var(--speakeasy-input-border-focus); }
.speakeasy__button {
    padding: .6rem 1rem;
    border: 0;
    border-radius: var(--speakeasy-radius);
    background: var(--speakeasy-button-bg);
    color: var(--speakeasy-button-fg);
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    font-size: 1rem;
}
.speakeasy__button:hover { background: var(--speakeasy-button-bg-hover); }
.speakeasy__error {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    margin: .5rem 0 0;
    color: var(--speakeasy-error);
    font-size: .875rem;
}
