{# Structural styles for the bundled unlock screen. Shared with the settings-page
   preview so the two can't drift. Theme values come from Settings::DEFAULT_CSS,
   which is included ahead of this. #}
* { box-sizing: border-box; }
body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    font-family: var(--speakeasy-font);
    background: var(--speakeasy-background);
    /* Base text colour, inherited by the lockdown message. The input restates it
       because form controls don't inherit it, and the button and error set theirs. */
    color: var(--speakeasy-text);
}
.speakeasy { width: 100%; max-width: 22rem; position: relative; }
.speakeasy__row { display: flex; gap: .5rem; }
.speakeasy__input {
    flex: 1 1 auto;
    padding: .6rem .75rem;
    border: 1px solid var(--speakeasy-input-border);
    border-radius: var(--speakeasy-radius);
    background: var(--speakeasy-input-background);
    color: var(--speakeasy-text);
    font-family: inherit;
    font-size: 1rem;
}
.speakeasy__input:focus { outline: none; border-color: var(--speakeasy-input-border-focus); }
/* `opacity: 1` because Firefox otherwise fades the placeholder on top of the colour. */
.speakeasy__input::placeholder { color: var(--speakeasy-placeholder-text); opacity: 1; }
.speakeasy__button {
    padding: .6rem 1rem;
    border: 0;
    border-radius: var(--speakeasy-radius);
    background: var(--speakeasy-button-background);
    color: var(--speakeasy-button-text);
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    font-size: 1rem;
}
.speakeasy__button:hover { background: var(--speakeasy-button-background-hover); }
/* Lockdown message: icon beside the text, the pair centred as a unit. `start`
   keeps the icon on the first line when the message wraps to several. */
.speakeasy--locked {
    display: flex;
    align-items: start;
    justify-content: center;
    gap: .75rem;
}
/* Matched on the element so swapping the icon's markup needs no class. Sized by
   height alone, letting the viewBox set the width, so any aspect ratio works.
   The 1.5rem line box centres it against the first line whatever that height is.
   `fill` is set here because the icon markup doesn't carry one, and
   `currentColor` then tracks the theme. `flex: 0 0 auto` stops a long message
   squashing it. */
.speakeasy--locked svg {
    flex: 0 0 auto;
    width: auto;
    height: 1.25rem;
    align-self: start;
    margin-block: calc((1.5rem - 1.25rem) / 2);
    fill: currentColor;
    opacity: .35;
}
.speakeasy__message {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
}
.speakeasy__error {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    margin: .5rem 0 0;
    color: var(--speakeasy-error-text);
    font-size: .875rem;
}
