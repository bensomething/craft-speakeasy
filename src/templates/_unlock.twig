{# Default unlock screen. Self-contained (no host CSS assumed). Override via the
   plugin's `template` setting to match your site. Receives `element`. #}
{% set flashError = craft.app.session.getFlash('error') %}
{% set sesameCss = craft.app.plugins.getPlugin('sesame').settings.safeCustomCss %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ element.title ?? 'Protected'|t('sesame') }}</title>
    <style>
        {{ constant('bensomething\\sesame\\models\\Settings::DEFAULT_CSS') | raw }}
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            font-family: var(--sesame-font);
            background: var(--sesame-bg);
            color: var(--sesame-fg);
        }
        .sesame { width: 100%; max-width: 22rem; }
        .sesame__row { display: flex; gap: .5rem; }
        .sesame__input {
            flex: 1 1 auto;
            padding: .6rem .75rem;
            border: 1px solid var(--sesame-input-border);
            border-radius: var(--sesame-radius);
            background: var(--sesame-input-bg);
            color: inherit;
            font-size: 1rem;
        }
        .sesame__input:focus { outline: none; border-color: var(--sesame-input-border-focus); }
        .sesame__button {
            padding: .6rem 1rem;
            border: 0;
            border-radius: var(--sesame-radius);
            background: var(--sesame-button-bg);
            color: var(--sesame-button-fg);
            font-weight: 600;
            cursor: pointer;
        }
        .sesame__button:hover { background: var(--sesame-button-bg-hover); }
        .sesame__error { margin: .5rem 0 0; color: var(--sesame-error); font-size: .875rem; }
        {# Custom overrides last so they win. Breakout-sanitised in Settings. #}
        {{ sesameCss|raw }}
    </style>
</head>
<body>
    <form class="sesame" method="post" accept-charset="utf-8">
        <input type="hidden" name="action" value="sesame/unlock">
        <input type="hidden" name="elementId" value="{{ element.id }}">
        {{ csrfInput() }}
        <div class="sesame__row">
            <input class="sesame__input" id="password" type="password" name="password" autocomplete="off" placeholder="{{ 'Password'|t('sesame') }}" autofocus>
            <button class="sesame__button" type="submit">{{ 'Enter'|t('sesame') }}</button>
        </div>
        {% if flashError %}
            <p class="sesame__error">{{ flashError }}</p>
        {% endif %}
    </form>
</body>
</html>
