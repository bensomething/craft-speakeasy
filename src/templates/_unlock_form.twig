{# Unlock form markup. Shared with the settings-page preview so the two can't
   drift. `preview` renders an inert copy: no action, no CSRF, nothing focusable
   that would steal the cursor from the CP behind the iframe. #}
{% set preview = preview ?? false %}
{% set flashError = flashError ?? null %}
<form class="speakeasy"{% if not preview %} method="post" accept-charset="utf-8"{% endif %}>
    {% if not preview %}
        <input type="hidden" name="action" value="speakeasy/unlock">
        <input type="hidden" name="elementId" value="{{ element.id }}">
        {{ csrfInput() }}
    {% endif %}
    <div class="speakeasy__row">
        <input class="speakeasy__input" type="password" name="password" autocomplete="off" placeholder="{{ 'Password'|t('speakeasy') }}"
            {%- if preview %} tabindex="-1" aria-hidden="true"{% else %} id="password" autofocus{% endif %}>
        <button class="speakeasy__button" type="{{ preview ? 'button' : 'submit' }}"
            {%- if preview %} tabindex="-1" aria-hidden="true"{% endif %}>{{ 'Enter'|t('speakeasy') }}</button>
    </div>
    {% if flashError %}
        <p class="speakeasy__error">{{ flashError }}</p>
    {% endif %}
</form>
