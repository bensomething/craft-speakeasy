{% import '_includes/forms' as forms %}

<h2 style="margin-top: 0;">{{ 'Settings'|t('sesame') }}</h2>

{{ forms.lightswitchField({
    label: 'Bypass for control-panel users'|t('sesame'),
    instructions: 'Skip the unlock screen for signed-in users who can view the element in the CP (admins included). Keeps live preview usable.'|t('sesame'),
    id: 'bypassForCpUsers',
    name: 'bypassForCpUsers',
    on: settings.bypassForCpUsers,
}) }}

{{ forms.textField({
    label: 'Max unlock attempts'|t('sesame'),
    instructions: 'Failed attempts per visitor IP + element before a lockout. Set to 0 to disable rate limiting.'|t('sesame'),
    id: 'maxAttempts',
    name: 'maxAttempts',
    value: settings.maxAttempts,
    size: 6,
    type: 'number',
    min: 0,
}) }}

{{ forms.textField({
    label: 'Lockout window (seconds)'|t('sesame'),
    instructions: 'How long a lockout lasts and how long failed attempts are counted.'|t('sesame'),
    id: 'attemptWindowSeconds',
    name: 'attemptWindowSeconds',
    value: settings.attemptWindowSeconds,
    size: 8,
    type: 'number',
    min: 0,
}) }}

{{ forms.autosuggestField({
    label: 'Unlock template'|t('sesame'),
    instructions: 'A site template to render for the unlock screen instead of the bundled default. It receives an `element` variable and must post to the `sesame/unlock` action.'|t('sesame'),
    id: 'template',
    name: 'template',
    value: settings.template,
    suggestions: craft.cp.getTemplateSuggestions(),
}) }}
